  "entries": [
    {
      "target": {
        "id": "catalog:cursor",
        "name": "Cursor (entire editor)",
        "kind": "app",
        "match": "Cursor",
        "enabled": false
      },
      "category": "agent host",
      "note": "Stops the whole editor, not only agent sessions.",
      "sources": [
        "https://cursor.com/docs/agent/overview"
      ]
    },
    {
      "target": {
        "id": "catalog:cursor-cli",
        "name": "Cursor CLI",
        "kind": "cli",
        "match": "cursor-agent",
        "enabled": false
      },
      "category": "agent",
      "note": "Retains the specific cursor-agent match. Current vendor docs launch via agent; that launcher is not automatically covered. Verify its executable identity before adding a target; no generic agent match is added.",
      "sources": [
        "https://cursor.com/docs/cli/overview",
        "https://docs.cursor.com/en/cli/overview"
      ]
    },
    {
      "target": {
        "id": "catalog:windsurf",
        "name": "Windsurf (entire editor)",
        "kind": "app",
        "match": "Windsurf",
        "enabled": false
      },
      "category": "agent host",
      "note": "Legacy Windsurf app-name match. Vendor now calls the product Devin Desktop; renamed installations are not confirmed covered. Verify the installed app identity before adding it. Stops the entire editor, not cloud work.",
      "sources": [
        "https://docs.devin.ai/desktop/terminal",
        "https://docs.devin.ai/desktop/getting-started"
      ]
    },
    {
      "target": {
        "id": "catalog:vscode",
